{
  "manifest_version": 3,
  "name": "Info Collector",
  "version": "0.2.0",
  "description": "本地优先的文章采集、可恢复处理与中文情报阅读工作台。",
  "key": "",
  "permissions": ["bookmarks", "storage", "alarms", "nativeMessaging", "activeTab", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Info Collector" },
  "options_page": "dashboard.html"
}
