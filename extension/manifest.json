{
  "manifest_version": 3,
  "name": "Info Collector",
  "version": "0.1.0",
  "description": "把收藏的文章变成持久处理队列：从书签只读导入，处理状态归扩展所有，外部流程经文件桥回报完成。",
  "key": "",
  "permissions": ["bookmarks", "storage", "alarms", "nativeMessaging", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Info Collector" },
  "options_page": "dashboard.html"
}
